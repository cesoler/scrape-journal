# --- Compose: database and API (interpolated into docker-compose.yml) ---
POSTGRES_USER=scrape
POSTGRES_PASSWORD=scrape
POSTGRES_DB=scrape_journal

# --- Running the API outside a container (npm run start:dev) only ---
# Under compose the host is "db", and the url is built from the POSTGRES_* values above.
DATABASE_URL=postgres://scrape:scrape@localhost:5432/scrape_journal
PORT=3000
